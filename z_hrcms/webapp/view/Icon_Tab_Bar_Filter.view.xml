                press="onRefresh"
            />
        </Toolbar>
        <Table
            id="humanResourceTable"
            items="{resorceTable>/humanResourceDetails}"
        >
            <columns>
                <Column hAlign="Center">
                    <Text text="Source Name" />
                </Column>
                <Column hAlign="Center">
                    <Text text="Priority" />
                </Column>
                <Column hAlign="Center">
                    <Text text="Date Created" />
                </Column>
                <Column hAlign="Center">
                    <Text text="Department" />
                </Column>
                <Column hAlign="Center">
                    <Text text="Status" />
                </Column>
                <Column>
                    <Text text="Location" />
                </Column>
                <Column hAlign="Center">
                    <Text text="Req Type" />
                </Column>
                <Column hAlign="Center">
                    <Text text="Req Sub Type" />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{resorceTable>sourceName}" />
                        <Text text="{resorceTable>Priority}" />
                        <Text text="{resorceTable>DateCreated}" />
                        <Text text="{resorceTable>Department}" />
                        <!-- <Text text="{resorceTable>Status}"></Text> -->
                        <ObjectStatus
                            text="{resorceTable>Status}"
                            state='{path:"resorceTable>Status", formatter:".formatter.onTextColor"}'
                        />
                        <Text text="{resorceTable>location}" />
                        <Text text="{resorceTable>reqType}" />
                        <Text text="{resorceTable>reqSubType}" />
                    </cells>
                </ColumnListItem>
            </items>
